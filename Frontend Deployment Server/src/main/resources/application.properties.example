spring.application.name=BuildBox_Frontend_Server
server.port=${SERVER_PORT:9000}

# =========================
# Database (Supabase PostgreSQL)
# =========================
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://<SUPABASE_HOST>:5432/postgres}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:<SUPABASE_USERNAME>}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:<SUPABASE_PASSWORD>}
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.datasource.hikari.maximum-pool-size=3

# Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true

# =========================
# Redis (Aiven Valkey)
# =========================
spring.data.redis.host=${REDIS_HOST:<AIVEN_REDIS_HOST>}
spring.data.redis.port=${REDIS_PORT:12608}
spring.data.redis.password=${REDIS_PASSWORD:<AIVEN_REDIS_PASSWORD>}
spring.data.redis.username=${REDIS_USERNAME:default}
spring.data.redis.ssl.enabled=true

# =========================
# Google OAuth
# =========================
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:<YOUR_GOOGLE_CLIENT_ID>}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:<YOUR_GOOGLE_CLIENT_SECRET>}
spring.security.oauth2.client.registration.google.redirect-uri=${OAUTH_REDIRECT_BASE_URL:http://localhost:9000}/login/oauth2/code/{registrationId}
spring.security.oauth2.client.registration.google.scope=email,profile

# =========================
# GitHub OAuth
# =========================
spring.security.oauth2.client.registration.github.client-id=${GITHUB_CLIENT_ID:<YOUR_GITHUB_CLIENT_ID>}
spring.security.oauth2.client.registration.github.client-secret=${GITHUB_CLIENT_SECRET:<YOUR_GITHUB_CLIENT_SECRET>}
spring.security.oauth2.client.registration.github.scope=user:email

# =========================
# JWT
# =========================
jwt.secretkey=${JWT_SECRET:<YOUR_JWT_SECRET>}

# =========================
# CORS
# =========================
cors.allowed.origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:5173,http://localhost:8080}

# =========================
# BuildServer Integration
# =========================
buildserver.url=${BUILDSERVER_URL:http://localhost:9191}